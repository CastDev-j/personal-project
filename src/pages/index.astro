---
import MainLayout from "@/layouts/MainLayout.astro";
import Form from "@/components/shared/Form";
import UserCard from "@/components/auth/UserCard.astro";
import VisitCounter from "@/components/shared/VisitCounter";
import { env } from "cloudflare:workers";

const user = Astro.locals.user;
const stub = env.VISIT_COUNTER.getByName("global");
const initialCount = await stub.increment("homes");
---

<MainLayout title="Inicio">
  <div class="flex flex-col gap-4">
    <VisitCounter initialCount={initialCount} client:load />
    {user && <UserCard user={user} />}
    <Form client:load />
  </div>
</MainLayout>
