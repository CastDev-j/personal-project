---
import MainLayout from "@/layouts/MainLayout.astro";
import Form from "@/components/shared/Form";
import UserCard from "@/components/auth/UserCard.astro";
import VisitCounter from "@/components/shared/VisitCounter";
import { env } from "cloudflare:workers";

const user = Astro.locals.user;
const stub = env.VISIT_COUNTER.getByName("global");

const [publicCount, authCount] = user
  ? await Promise.all([
      stub.increment("public"),
      stub.increment("authenticated", user.id),
    ])
  : [await stub.increment("public"), null];
---

<MainLayout title="Inicio">
  <div class="flex flex-col gap-4">
    <VisitCounter
      publicCount={publicCount}
      authCount={authCount}
      isAuthenticated={!!user}
      client:load
    />
    {user && <UserCard user={user} />}
    <Form client:load />
  </div>
</MainLayout>
